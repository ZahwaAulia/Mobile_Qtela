<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EC"
    tools:context=".pertemuan3.ThirdResultActivity">


    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="274dp"
        android:layout_height="407dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.562"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.435"
        app:srcCompat="@drawable/lima" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="1671dp"
        android:layout_height="766dp"
        android:layout_marginTop="320dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/enam" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="193dp"
        android:layout_height="289dp"
        android:layout_marginEnd="296dp"
        android:layout_marginBottom="528dp"
        android:rotation="73"
        android:rotationY="17"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/tujuh" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="328dp"
        android:layout_height="47dp"
        android:fontFamily="sans-serif-medium"
        android:justificationMode="inter_word"
        android:text="@string/descripsi"
        android:textAlignment="center"
        android:textColor="#1A523A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.254" />


    <TextView
        android:id="@+id/textView"
        android:layout_width="360dp"
        android:layout_height="66dp"
        android:fontFamily="@font/vanila"
        android:text="Waktunya Smash!"
        android:textColor="#F37335"
        android:textColorLink="#3A0E0E"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.151" />

    <Button
        android:id="@+id/btntofifth"
        android:layout_width="181dp"
        android:layout_height="51dp"
        android:layout_marginBottom="224dp"
        android:backgroundTint="#F37335"
        android:text="Sign in"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btntofifth2"
        android:layout_width="176dp"
        android:layout_height="50dp"
        android:layout_marginBottom="152dp"
        android:backgroundTint="#F37335"
        android:text="Sign Up"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>