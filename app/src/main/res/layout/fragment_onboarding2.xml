<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/bg_main">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/badminton"
        android:contentDescription="Badminton Court"
        android:scaleType="centerCrop" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/vanila"
        android:text="Pilih Lapangan &amp; Jam"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pilih jam main dan lapangan berkualitas lengkap dengan lantai standar &amp; lampu LED penerangan."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textAlignment="center" />

</LinearLayout>