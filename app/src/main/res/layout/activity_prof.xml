<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EC"
    tools:context=".ProfActivity">

    <!-- TOOLBAR ATAS -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1A523A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A523A"
            app:title="Profile"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- KONTEN PROFIL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@id/toolbar1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="130dp"
            android:layout_height="150dp"
            android:contentDescription="Foto profil"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/brow"
            android:text="Zahwa Aulia"
            android:textColor="#1A523A"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/imageView3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageView3"
            app:layout_constraintBottom_toBottomOf="@id/imageView3"
            app:layout_constraintVertical_bias="0.3" />

        <ImageView
            android:id="@+id/imageprof"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Ikon data diri"
            android:src="@drawable/proff"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView3" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Data Diri"
            android:textColor="#1A523A"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageprof"
            app:layout_constraintTop_toTopOf="@id/imageprof"
            app:layout_constraintBottom_toBottomOf="@id/imageprof" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#F37335"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:cornerRadius="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NAVIGASI BAWAH -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar1"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#1A523A"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageBerandaa"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Beranda"
            android:src="@drawable/beranda"
            app:layout_constraintEnd_toStartOf="@id/imagelapangan"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textberanda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Beranda"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/imageBerandaa"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageBerandaa" />

        <ImageView
            android:id="@+id/imagelapangan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Lapangan"
            android:src="@drawable/lapangan"
            app:layout_constraintStart_toEndOf="@id/imageBerandaa"
            app:layout_constraintEnd_toStartOf="@id/imageboking"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textlapangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lapangan"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/imagelapangan"
            app:layout_constraintStart_toStartOf="@id/imagelapangan"
            app:layout_constraintEnd_toEndOf="@id/imagelapangan" />

        <ImageView
            android:id="@+id/imageboking"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Booking"
            android:src="@drawable/booking"
            app:layout_constraintStart_toEndOf="@id/imagelapangan"
            app:layout_constraintEnd_toStartOf="@id/imageriwayat"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textpbooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/imageboking"
            app:layout_constraintStart_toStartOf="@id/imageboking"
            app:layout_constraintEnd_toEndOf="@id/imageboking" />

        <ImageView
            android:id="@+id/imageriwayat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Riwayat"
            android:src="@drawable/riwayat"
            app:layout_constraintStart_toEndOf="@id/imageboking"
            app:layout_constraintEnd_toStartOf="@id/imageprofilee"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textriwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/imageriwayat"
            app:layout_constraintStart_toStartOf="@id/imageriwayat"
            app:layout_constraintEnd_toEndOf="@id/imageriwayat" />

        <ImageView
            android:id="@+id/imageprofilee"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Profile"
            android:src="@drawable/profilee"
            app:layout_constraintStart_toEndOf="@id/imageriwayat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/imageprofilee"
            app:layout_constraintStart_toStartOf="@id/imageprofilee"
            app:layout_constraintEnd_toEndOf="@id/imageprofilee" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>