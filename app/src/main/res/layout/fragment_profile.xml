<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8EC"
    tools:context=".Profile.ProfileFragment">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A523A"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A523A"
            app:title="Profil"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- KONTEN PROFIL YANG BISA DI-SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FOTO DAN NAMA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="Foto profil"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/profile" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/brow"
                    android:text="Zahwa Aulia"
                    android:textColor="#1A523A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- KARTU DATA DIRI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E8E0D3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Data Diri"
                        android:textColor="#1A523A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- NAMA LENGKAP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView6"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon nama"
                            app:srcCompat="@drawable/nama" />

                        <TextView
                            android:id="@+id/namaa"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Nama Lengkap"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Zahwa Aulia"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView7"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon email"
                            app:srcCompat="@drawable/email" />

                        <TextView
                            android:id="@+id/email"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Email"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Zahwa@gmail.com"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- LOKASI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView9"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon lokasi"
                            app:srcCompat="@drawable/lokasi" />

                        <TextView
                            android:id="@+id/lokasi"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Lokasi"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pekanbaru"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- PENDIDIKAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView8"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon pendidikan"
                            app:srcCompat="@drawable/pendidikan" />

                        <TextView
                            android:id="@+id/pendidikan"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Pendidikan"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="D4 Teknik Informatika"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- TANGGAL LAHIR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView10"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon tanggal lahir"
                            app:srcCompat="@drawable/kalender" />

                        <TextView
                            android:id="@+id/tgllahir"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Tanggal Lahir"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="31 Agustus 2006"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- HOBI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:id="@+id/imageView11"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Ikon hobi"
                            app:srcCompat="@drawable/buku" />

                        <TextView
                            android:id="@+id/hobi"
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Hobi"
                            android:textColor="#1A523A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hbi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Membaca"
                            android:textColor="#1A523A"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU SOSIAL MEDIA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E8E0D3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/sosmed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Sosial Media"
                        android:textAlignment="center"
                        android:textColor="#1A523A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- INSTAGRAM -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/image1"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="Instagram"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/ig" />

                            <TextView
                                android:id="@+id/ig"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="zhwalyaaa"
                                android:textColor="#1A523A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- LINKEDIN -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/in"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="LinkedIn"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/in" />

                            <TextView
                                android:id="@+id/in1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="zahwaaulia"
                                android:textColor="#1A523A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- YOUTUBE -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/youtube"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="YouTube"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/youtube" />

                            <TextView
                                android:id="@+id/ytb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="zhwa"
                                android:textColor="#1A523A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
