<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/polos"
    tools:context=".FifthActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFF3D0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:subtitleTextColor="#8B0000"
            app:titleTextColor="#8B0000"
            app:layout_scrollFlags="scroll|enterAlways">


        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnWebView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebView"
                android:textColor="#8B0000"
                android:backgroundTint="#FFF3E0"
                app:icon="@drawable/ic_linkk"
                app:iconSize="30dp"
                app:iconGravity="textStart"/>


            <!-- Konten informasi website Qtela -->

            <!-- Konten informasi website Qtela -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tentang Qtela"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qtela merupakan merek makanan ringan yang menawarkan camilan dengan bahan dasar singkong dan berbagai pilihan lainnya. Qtela cocok dinikmati saat bersantai bersama keluarga dan teman."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Produk Qtela"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qtela menyediakan berbagai pilihan camilan yang dapat dinikmati dalam berbagai suasana. Setiap produk memiliki karakteristik dan rasa yang berbeda."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Varian Rasa"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qtela memiliki pilihan rasa yang beragam. Kamu dapat melihat informasi varian rasa melalui kemasan produk atau saluran resmi Qtela."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keunggulan Qtela"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qtela dapat menjadi pilihan camilan untuk menemani waktu santai, menonton film, belajar, atau berkumpul bersama teman. Kemasannya juga praktis untuk dibawa bepergian."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informasi Produk"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Untuk mengetahui informasi lebih lanjut mengenai produk, varian, dan merek Qtela, kamu dapat mengunjungi website resmi Qtela atau situs produsen yang menaunginya."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nikmati Qtela"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temukan camilan Qtela pilihanmu dan nikmati waktu santai dengan camilan favorit. Jangan lupa periksa informasi pada kemasan sebelum membeli."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>