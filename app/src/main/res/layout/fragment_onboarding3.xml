<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/bg_main">

    <ImageView
        android:layout_width="254dp"
        android:layout_height="265dp"
        android:contentDescription="Notification Alarm"
        android:scaleType="fitCenter"
        android:src="@drawable/alarm" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/vanila"
        android:text="Notifikasi Alarm Pengingat"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Dapatkan notifikasi alarm pengingat sebelum pertandingan dimulai agar tidak terlambat!"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textAlignment="center" />

</LinearLayout>