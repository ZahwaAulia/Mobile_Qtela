<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EC"
    tools:context=".ProfileActivity">

    <!-- TOOLBAR ATAS -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8EC">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A523A"
            app:layout_scrollFlags="scroll|enterAlways"
            app:titleTextColor="#FFFFFF"
            app:subtitleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- KONTEN PROFIL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="140dp"
            android:layout_height="143dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Foto profil"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/profile" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWebView"
            android:layout_width="361dp"
            android:layout_height="164dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFF8EC"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.473"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="347dp"
                android:layout_height="201dp"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="20dp"
                    android:layout_height="17dp"
                    android:contentDescription="Ikon nama"
                    app:layout_constraintBottom_toBottomOf="@id/namaa"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/namaa"
                    app:srcCompat="@drawable/nama" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Zahwa Aulia"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/namaa"
                    app:layout_constraintTop_toTopOf="@id/namaa" />

                <TextView
                    android:id="@+id/namaa"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nama Lengkap"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/imageView6"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="21dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Ikon email"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/namaa"
                    app:srcCompat="@drawable/email" />

                <TextView
                    android:id="@+id/email"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Email"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/imageView7"
                    app:layout_constraintStart_toEndOf="@id/imageView7"
                    app:layout_constraintTop_toTopOf="@id/imageView7" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Zahwa@gmail.com"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/email"
                    app:layout_constraintTop_toTopOf="@id/email" />

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Ikon lokasi"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/email"
                    app:srcCompat="@drawable/lokasi" />

                <TextView
                    android:id="@+id/lokasi"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lokasi"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/imageView9"
                    app:layout_constraintStart_toEndOf="@id/imageView9"
                    app:layout_constraintTop_toTopOf="@id/imageView9" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Pekanbaru"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lokasi"
                    app:layout_constraintTop_toTopOf="@id/lokasi" />

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Ikon pendidikan"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lokasi"
                    app:srcCompat="@drawable/pendidikan" />

                <TextView
                    android:id="@+id/pendidikan"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Pendidikan"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/imageView8"
                    app:layout_constraintStart_toEndOf="@id/imageView8"
                    app:layout_constraintTop_toTopOf="@id/imageView8" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D4 Teknik Informatika"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/pendidikan"
                    app:layout_constraintTop_toTopOf="@id/pendidikan" />

                <ImageView
                    android:id="@+id/imageView10"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Ikon tanggal lahir"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pendidikan"
                    app:srcCompat="@drawable/kalender" />

                <TextView
                    android:id="@+id/tgllahir"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Tanggal Lahir"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/imageView10"
                    app:layout_constraintStart_toEndOf="@id/imageView10"
                    app:layout_constraintTop_toTopOf="@id/imageView10" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="31 Agustus 2006"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tgllahir"
                    app:layout_constraintTop_toTopOf="@id/tgllahir" />

                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tgllahir"
                    app:srcCompat="@drawable/buku" />

                <TextView
                    android:id="@+id/hbi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Membaca"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/hobi"
                    app:layout_constraintTop_toTopOf="@id/hobi" />

                <TextView
                    android:id="@+id/hobi"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Hobi"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/imageView11"
                    app:layout_constraintStart_toEndOf="@id/imageView11"
                    app:layout_constraintTop_toTopOf="@id/imageView11"
                    app:layout_constraintVertical_bias="0.75" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWebView1"
            android:layout_width="352dp"
            android:layout_height="122dp"
            android:layout_marginTop="196dp"
            app:cardBackgroundColor="#FFF8EC"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.481"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="347dp"
                android:layout_height="201dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/sosmed"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Sosial Media"
                    android:textAlignment="center"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/image1"
                    android:layout_width="68dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ig" />

                <TextView
                    android:id="@+id/ig"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="76dp"
                    android:text="zhwalyaaa"
                    android:textAlignment="center"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/in"
                    android:layout_width="74dp"
                    android:layout_height="59dp"
                    android:layout_marginStart="120dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/in" />

                <TextView
                    android:id="@+id/in1"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="52dp"
                    android:text="zahwaaulia"
                    android:textAlignment="center"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.497"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/in" />

                <ImageView
                    android:id="@+id/youtube"
                    android:layout_width="74dp"
                    android:layout_height="59dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.929"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/youtube" />

                <TextView
                    android:id="@+id/ytb"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="52dp"
                    android:text="zhwa"
                    android:textAlignment="center"
                    android:textColor="#1A523A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/in" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="183dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/brow"
            android:text="Zahwa Aulia"
            android:textColor="#1A523A"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TOOLBAR BAWAH: DIPINDAHKAN KE LUAR KONTEN PROFIL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar1"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="#1A523A"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/imageBerandaa"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Beranda"
            android:src="@drawable/beranda"
            app:layout_constraintEnd_toStartOf="@id/imagelapangan"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textberanda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beranda"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/imageBerandaa"
            app:layout_constraintStart_toStartOf="@id/imageBerandaa"
            app:layout_constraintTop_toBottomOf="@id/imageBerandaa" />

        <ImageView
            android:id="@+id/imagelapangan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Lapangan"
            android:src="@drawable/lapangan"
            app:layout_constraintEnd_toStartOf="@id/imageboking"
            app:layout_constraintStart_toEndOf="@id/imageBerandaa"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textlapangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lapangan"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/imagelapangan"
            app:layout_constraintStart_toStartOf="@id/imagelapangan"
            app:layout_constraintTop_toBottomOf="@id/imagelapangan" />

        <ImageView
            android:id="@+id/imageboking"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Booking"
            android:src="@drawable/booking"
            app:layout_constraintEnd_toStartOf="@id/imageriwayat"
            app:layout_constraintStart_toEndOf="@id/imagelapangan"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textpbooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/imageboking"
            app:layout_constraintStart_toStartOf="@id/imageboking"
            app:layout_constraintTop_toBottomOf="@id/imageboking" />

        <ImageView
            android:id="@+id/imageriwayat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Riwayat"
            android:src="@drawable/riwayat"
            app:layout_constraintEnd_toStartOf="@id/imageprofilee"
            app:layout_constraintStart_toEndOf="@id/imageboking"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textriwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/imageriwayat"
            app:layout_constraintStart_toStartOf="@id/imageriwayat"
            app:layout_constraintTop_toBottomOf="@id/imageriwayat" />

        <ImageView
            android:id="@+id/imageprofilee"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Profile"
            android:src="@drawable/profilee"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageriwayat"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textprofile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#FFF8EC"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/imageprofilee"
            app:layout_constraintStart_toStartOf="@id/imageprofilee"
            app:layout_constraintTop_toBottomOf="@id/imageprofilee" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
