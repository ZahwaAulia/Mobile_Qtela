<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EC"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOOLBAR ATAS -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#FFF8EC"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#1A523A"
                app:titleTextColor="#FFFFFF" />

            <ImageView
                android:id="@+id/imageView12"
                android:layout_width="136dp"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo Beranda"
                app:srcCompat="@drawable/beranda" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- KONTEN UTAMA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout"
            app:layout_constraintBottom_toTopOf="@id/toolbar1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="196dp"
                android:layout_height="195dp"
                android:contentDescription="Ilustrasi badminton"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/lima"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWebView"
                android:layout_width="0dp"
                android:layout_height="164dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/imageView2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_max="360dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/textweb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Portal Kabar Badminton"
                        android:textAlignment="center"
                        android:textColor="#1A523A"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Jangan ketinggalan kabar terbaru seputar dunia badminton lokal hingga internasional"
                        android:textAlignment="center"
                        android:textColor="#1A523A"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@id/textweb"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWebView"
                        android:layout_width="137dp"
                        android:layout_height="40dp"
                        android:backgroundTint="#F37335"
                        android:text="WebView"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="4dp"
                        app:icon="@drawable/ic_linkk"
                        app:iconGravity="textStart"
                        app:iconSize="22dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- NAVIGASI BAWAH -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="#1A523A"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BERANDA -->
            <ImageView
                android:id="@+id/imageBeranda"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Beranda"
                android:src="@drawable/beranda"
                app:layout_constraintEnd_toStartOf="@id/imagelapangan"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textberanda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textColor="#FFF8EC"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/imageBeranda"
                app:layout_constraintStart_toStartOf="@id/imageBeranda"
                app:layout_constraintEnd_toEndOf="@id/imageBeranda" />

            <!-- LAPANGAN -->
            <ImageView
                android:id="@+id/imagelapangan"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Lapangan"
                android:src="@drawable/lapangan"
                app:layout_constraintStart_toEndOf="@id/imageBeranda"
                app:layout_constraintEnd_toStartOf="@id/imageboking"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textlapangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lapangan"
                android:textColor="#FFF8EC"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/imagelapangan"
                app:layout_constraintStart_toStartOf="@id/imagelapangan"
                app:layout_constraintEnd_toEndOf="@id/imagelapangan" />

            <!-- BOOKING -->
            <ImageView
                android:id="@+id/imageboking"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Booking"
                android:src="@drawable/booking"
                app:layout_constraintStart_toEndOf="@id/imagelapangan"
                app:layout_constraintEnd_toStartOf="@id/imageriwayat"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textpbooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking"
                android:textColor="#FFF8EC"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/imageboking"
                app:layout_constraintStart_toStartOf="@id/imageboking"
                app:layout_constraintEnd_toEndOf="@id/imageboking" />

            <!-- RIWAYAT -->
            <ImageView
                android:id="@+id/imageriwayat"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Riwayat"
                android:src="@drawable/riwayat"
                app:layout_constraintStart_toEndOf="@id/imageboking"
                app:layout_constraintEnd_toStartOf="@id/imageprofilee"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textriwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat"
                android:textColor="#FFF8EC"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/imageriwayat"
                app:layout_constraintStart_toStartOf="@id/imageriwayat"
                app:layout_constraintEnd_toEndOf="@id/imageriwayat" />

            <!-- PROFILE -->
            <ImageView
                android:id="@+id/imageprofilee"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Profile"
                android:src="@drawable/profilee"
                app:layout_constraintStart_toEndOf="@id/imageriwayat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#FFF8EC"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/imageprofilee"
                app:layout_constraintStart_toStartOf="@id/imageprofilee"
                app:layout_constraintEnd_toEndOf="@id/imageprofilee" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>